{
  "name": "royal-crest-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Royal Crest Hotel & Suites (Express + MongoDB)",
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/index.js",
