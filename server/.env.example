# Copy to .env and edit.
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/royal-crest

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma separated list of origins allowed to call the API (the React dev server by default)
CLIENT_URL=http://localhost:5173

# Hotel local timezone, used to decide what "today" means for bookings
HOTEL_TIMEZONE=Africa/Lagos

# true  = bookings are confirmed instantly
# false = bookings start as "pending" until an admin confirms them
AUTO_CONFIRM_BOOKINGS=true

# Credentials created by `npm run seed`
ADMIN_NAME=Hotel Administrator
ADMIN_EMAIL=admin@royalcresthotel.com
ADMIN_PASSWORD=ChangeMe!2026
